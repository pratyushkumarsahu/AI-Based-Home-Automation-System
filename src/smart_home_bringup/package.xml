<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>smart_home_bringup</name>
  <version>1.0.0</version>
  <description>Master bringup package for Smart Home Monitoring and Suspicious Activity Detection System</description>
  <maintainer email="student@todo.todo">Student</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>smart_home_interfaces</exec_depend>
  <exec_depend>smart_home_description</exec_depend>
  <exec_depend>smart_home_gazebo</exec_depend>
  <exec_depend>smart_home_navigation</exec_depend>
  <exec_depend>smart_home_detection</exec_depend>
  <exec_depend>smart_home_decision</exec_depend>
  <exec_depend>smart_home_alerts</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>ros_gz_sim</exec_depend>
  <exec_depend>ros_gz_bridge</exec_depend>
  <exec_depend>xacro</exec_depend>
 
  <test_depend>ament_lint_auto</test_depend>
  <test_depend>launch_testing_ament_cmake</test_depend>
  <test_depend>launch_testing_ros</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
