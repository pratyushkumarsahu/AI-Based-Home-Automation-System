<?xml version="1.0" ?>
<sdf version="1.9">
  <model name="gas_stove">
    <static>true</static>
    <pose>0 0 0 0 0 0</pose>
    <link name="stove_body">
      <!-- Base cabinet -->
      <visual name="cabinet_visual">
        <pose>0 0 0.42 0 0 0</pose>
        <geometry>
          <box>
            <size>0.80 0.80 0.84</size>
          </box>
        </geometry>
        <material>
          <ambient>0.2 0.2 0.25 1</ambient>
          <diffuse>0.3 0.3 0.35 1</diffuse>
        </material>
      </visual>

      <!-- Stove Cooktop surface -->
      <visual name="cooktop_visual">
        <pose>0 0 0.85 0 0 0</pose>
        <geometry>
          <box>
            <size>0.82 0.82 0.04</size>
          </box>
        </geometry>
        <material>
          <ambient>0.1 0.1 0.1 1</ambient>
          <diffuse>0.15 0.15 0.15 1</diffuse>
        </material>
      </visual>

      <!-- Burner ring visual (gas emission point) -->
      <visual name="burner_visual">
        <pose>0 0 0.88 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.15</radius>
            <length>0.03</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.8 0.4 0.1 1</ambient>
          <diffuse>0.9 0.5 0.2 1</diffuse>
        </material>
      </visual>

      <!-- Collision box -->
      <collision name="stove_collision">
        <pose>0 0 0.45 0 0 0</pose>
        <geometry>
          <box>
            <size>0.82 0.82 0.90</size>
          </box>
        </geometry>
      </collision>
    </link>
  </model>
</sdf>
