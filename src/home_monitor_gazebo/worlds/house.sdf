<?xml version="1.0" ?>
<sdf version="1.10">

  <world name="home_monitor_house">

    <!-- ========================================================= -->
    <!-- PHYSICS                                                   -->
    <!-- ========================================================= -->

    <physics name="1ms" type="gz">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>


    <!-- ========================================================= -->
    <!-- GAZEBO SYSTEM PLUGINS                                     -->
    <!-- ========================================================= -->

    <plugin
      filename="gz-sim-physics-system"
      name="gz::sim::systems::Physics"/>

    <plugin
      filename="gz-sim-sensors-system"
      name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <plugin
      filename="gz-sim-scene-broadcaster-system"
      name="gz::sim::systems::SceneBroadcaster"/>


    <!-- ========================================================= -->
    <!-- SUN / LIGHT                                               -->
    <!-- ========================================================= -->

    <light name="sun" type="directional">

      <cast_shadows>true</cast_shadows>

      <pose>0 0 10 0 0 0</pose>

      <diffuse>1.0 1.0 1.0 1</diffuse>
      <specular>0.35 0.35 0.35 1</specular>

      <direction>-0.5 0.3 -1</direction>

    </light>


    <!-- ========================================================= -->
    <!-- GROUND                                                    -->
    <!-- ========================================================= -->

    <model name="ground">

      <static>true</static>

      <link name="ground_link">

        <collision name="ground_collision">

          <geometry>

            <plane>
              <normal>0 0 1</normal>
              <size>30 30</size>
            </plane>

          </geometry>

        </collision>


        <visual name="ground_visual">

          <geometry>

            <plane>
              <normal>0 0 1</normal>
              <size>30 30</size>
            </plane>

          </geometry>

          <material>

            <ambient>0.45 0.45 0.45 1</ambient>
            <diffuse>0.55 0.55 0.55 1</diffuse>
            <specular>0.10 0.10 0.10 1</specular>

          </material>

        </visual>

      </link>

    </model>


