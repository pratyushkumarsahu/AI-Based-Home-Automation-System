<?xml version="1.0" ?>
<sdf version="1.10">

  <world name="home_monitor_house">

    <!-- ========================================================= -->
    <!-- PHYSICS                                                   -->
    <!-- ========================================================= -->

    <physics name="1ms" type="gz">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>


    <!-- ========================================================= -->
    <!-- GAZEBO SYSTEM PLUGINS                                     -->
    <!-- ========================================================= -->

    <plugin
      filename="gz-sim-physics-system"
      name="gz::sim::systems::Physics"/>

    <plugin
      filename="gz-sim-sensors-system"
      name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <plugin
      filename="gz-sim-scene-broadcaster-system"
      name="gz::sim::systems::SceneBroadcaster"/>


    <!-- ========================================================= -->
    <!-- SUN / LIGHT                                                -->
    <!-- ========================================================= -->

    <light name="sun" type="directional">
      <cast_shadows>true</cast_shadows>

      <pose>0 0 10 0 0 0</pose>

      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>

      <direction>-0.5 0.3 -1</direction>
    </light>


    <!-- ========================================================= -->
    <!-- GROUND                                                     -->
    <!-- ========================================================= -->

    <model name="ground">

      <static>true</static>

      <link name="ground_link">

        <collision name="ground_collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>30 30</size>
            </plane>
          </geometry>
        </collision>

        <visual name="ground_visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>30 30</size>
            </plane>
          </geometry>
        </visual>

      </link>

    </model>


    <!-- ========================================================= -->
    <!-- HOUSE OUTER WALLS                                         -->
    <!-- EXISTING WALLS - DIMENSIONS KEPT UNCHANGED                -->
    <!-- ========================================================= -->


    <!-- ================= BACK WALL ================= -->

    <model name="back_wall">

      <static>true</static>

      <pose>0 6.86 1.5 0 0 0</pose>

      <link name="wall">

        <collision name="collision">
          <geometry>
            <box>
              <size>16.46 0.20 3.0</size>
            </box>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <box>
              <size>16.46 0.20 3.0</size>
            </box>
          </geometry>
        </visual>

      </link>

    </model>


    <!-- ================= FRONT WALL ================= -->

    <model name="front_wall">

      <static>true</static>

      <pose>0 -6.86 1.5 0 0 0</pose>

      <link name="wall">

        <collision name="collision">
          <geometry>
            <box>
              <size>16.46 0.20 3.0</size>
            </box>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <box>
              <size>16.46 0.20 3.0</size>
            </box>
          </geometry>
        </visual>

      </link>

    </model>


    <!-- ================= LEFT WALL ================= -->

    <model name="left_wall">

      <static>true</static>

      <pose>-8.23 0 1.5 0 0 0</pose>

      <link name="wall">

        <collision name="collision">
          <geometry>
            <box>
              <size>0.20 13.72 3.0</size>
            </box>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <box>
              <size>0.20 13.72 3.0</size>
            </box>
          </geometry>
        </visual>

      </link>

    </model>


    <!-- ================= RIGHT WALL ================= -->

    <model name="right_wall">

      <static>true</static>

      <pose>8.23 0 1.5 0 0 0</pose>

      <link name="wall">

        <collision name="collision">
          <geometry>
            <box>
              <size>0.20 13.72 3.0</size>
            </box>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <box>
              <size>0.20 13.72 3.0</size>
            </box>
          </geometry>
        </visual>

      </link>

    </model>


    <!-- ========================================================= -->
    <!-- EXISTING BEDROOM WALLS                                    -->
    <!-- DO NOT CHANGE                                             -->
    <!-- ========================================================= -->


    <!-- ================= BEDROOM 1 WALL ================= -->

    <model name="bedroom1_wall">

      <static>true</static>

      <pose>-2.70 3.60 1.50 0 0 0</pose>

      <link name="wall">

        <collision name="collision">
          <geometry>
            <box>
              <size>0.18 6.50 3.0</size>
            </box>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <box>
              <size>0.18 6.50 3.0</size>
            </box>
          </geometry>
        </visual>

      </link>

    </model>


    <!-- ================= BEDROOM 2 WALL ================= -->

    <model name="bedroom2_wall">

      <static>true</static>

      <pose>2.70 3.60 1.50 0 0 0</pose>

      <link name="wall">

        <collision name="collision">
          <geometry>
            <box>
              <size>0.18 6.50 3.0</size>
            </box>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <box>
              <size>0.18 6.50 3.0</size>
            </box>
          </geometry>
        </visual>

      </link>

    </model>


    <!-- ========================================================= -->
    <!-- KITCHEN & DINING AREA                                     -->
    <!-- ========================================================= -->

    <!--
      This wall continues the left bedroom partition downward.

      It separates:
          LEFT  -> Kitchen & Dining
          RIGHT -> Living Hall

      The wall deliberately stops before the bedroom wall,
      leaving an opening/passage for the kitchen entrance.
    -->

    <model name="kitchen_living_partition">

      <static>true</static>

      <pose>-2.70 -4.05 1.50 0 0 0</pose>

      <link name="wall">

        <collision name="collision">
          <geometry>
            <box>
              <size>0.18 5.40 3.0</size>
            </box>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <box>
              <size>0.18 5.40 3.0</size>
            </box>
          </geometry>
        </visual>

      </link>

    </model>


    <!-- ========================================================= -->
    <!-- KITCHEN BACK / DINING PARTITION                           -->
    <!-- ========================================================= -->

    <!--
      Short horizontal wall defining the upper edge of the
      kitchen/dining zone.

      Opening is intentionally left toward the living hall.
    -->

    <model name="kitchen_back_wall">

      <static>true</static>

      <pose>-5.45 -1.45 1.50 0 0 0</pose>

      <link name="wall">

        <collision name="collision">
          <geometry>
            <box>
              <size>5.55 0.18 3.0</size>
            </box>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <box>
              <size>5.55 0.18 3.0</size>
            </box>
          </geometry>
        </visual>

      </link>

    </model>


    <!-- ========================================================= -->
    <!-- LIVING HALL RIGHT-SIDE PARTITION                          -->
    <!-- ========================================================= -->

    <!--
      Defines the right side of the main living area while
      keeping an opening for the future common toilet / passage.
    -->

    <model name="living_right_partition">

      <static>true</static>

      <pose>5.10 -3.25 1.50 0 0 0</pose>

      <link name="wall">

        <collision name="collision">
          <geometry>
            <box>
              <size>0.18 5.40 3.0</size>
            </box>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <box>
              <size>0.18 5.40 3.0</size>
            </box>
          </geometry>
        </visual>

      </link>

    </model>


    <!-- ========================================================= -->
    <!-- POoja ROOM SIDE WALLS                                     -->
    <!-- ========================================================= -->

    <!-- Left side of future Pooja room -->

    <model name="pooja_left_wall">

      <static>true</static>

      <pose>-0.90 -1.60 1.50 0 0 0</pose>

      <link name="wall">

        <collision name="collision">
          <geometry>
            <box>
              <size>0.18 2.50 3.0</size>
            </box>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <box>
              <size>0.18 2.50 3.0</size>
            </box>
          </geometry>
        </visual>

      </link>

    </model>


    <!-- Right side of future Pooja room -->

    <model name="pooja_right_wall">

      <static>true</static>

      <pose>0.90 -1.60 1.50 0 0 0</pose>

      <link name="wall">

        <collision name="collision">
          <geometry>
            <box>
              <size>0.18 2.50 3.0</size>
            </box>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <box>
              <size>0.18 2.50 3.0</size>
            </box>
          </geometry>
        </visual>

      </link>

    </model>


  </world>

</sdf>
